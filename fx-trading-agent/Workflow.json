        "jsCode": "const workflowStaticData = $getWorkflowStaticData('global');\nconst decision = workflowStaticData.lastDecision || {\n  action: \"HOLD\",\n  symbol: \"SPY\", \n  confidence: 0.5,\n  reason: \"No decision yet\",\n  timestamp: \"\"\n};\nreturn [{ json: decision }];"
