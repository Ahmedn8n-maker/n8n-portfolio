    {
      "parameters": {
        "jsCode": "const orders = $input.all().map(i => i.json);\n\nreturn orders.map(o => {\n  const filledAt = new Date(o.filled_at);\n  \n  return {\n    json: {\n      // Trade Log columns\n      date: filledAt.toLocaleDateString('en-US', { timeZone: 'America/New_York' }),\n      time_et: filledAt.toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour: '2-digit', minute: '2-digit' }),\n      symbol: o.symbol,\n      side: o.side.toUpperCase(),\n      qty: parseFloat(o.filled_qty),\n      fill_price: parseFloat(o.filled_avg_price).toFixed(3),\n      order_value: (parseFloat(o.filled_avg_price) * parseFloat(o.filled_qty)).toFixed(2),\n      stop_loss: 'N/A',\n      take_profit: 'N/A',\n      order_id: o.id,\n      status: o.status\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        112
      ],
      "id": "911c7ae8-0ee4-455d-a995-a325a3bc5d70",
      "name": "Format Trade Log"
    },
    {
      "parameters": {
        "jsCode": "const portfolio = $input.first().json;\n\nconst equityArr = portfolio.equity;\nconst plArr = portfolio.profit_loss;\nconst lastIdx = equityArr.length - 1;\n\nconst netPnl = plArr[lastIdx];\nconst netPnlPct = (portfolio.profit_loss_pct[lastIdx] * 100).toFixed(2);\nconst bestEquity = Math.max(...equityArr);\nconst worstEquity = Math.min(...equityArr);\nconst biggestSwing = (bestEquity - worstEquity).toFixed(2);\n\nreturn [{\n  json: {\n    date: portfolio.base_value_asof,\n    starting_equity: equityArr[0].toFixed(2),\n    ending_equity: equityArr[lastIdx].toFixed(2),\n    net_pnl: netPnl.toFixed(2),\n    net_pnl_pct: netPnlPct + '%',\n    best_equity: bestEquity.toFixed(2),\n    worst_equity: worstEquity.toFixed(2),\n    biggest_swing: biggestSwing,\n    num_trades: null,         // ⚠️ not available here — comes from Trades node\n    total_bought: null,       // ⚠️ not available here — comes from Trades node\n    total_sold: null,         // ⚠️ not available here — comes from Trades node\n    result: netPnl >= 0 ? '✅ Profit' : '❌ Loss'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
