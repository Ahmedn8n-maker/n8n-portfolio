    {
      "parameters": {
        "jsCode": "const q = $input.first().json.quote;\n\nreturn [{\n  json: {\n    body: {\n      symbol: \"AAPL\",\n      bp: q.bp,\n      ap: q.ap,\n      bs: q.bs,\n      as: q.as,\n      lp: q.ap,\n      timestamp: q.t\n    }\n  }\n}];"
