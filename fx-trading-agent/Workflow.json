      "parameters": {
        "jsCode": "const order  = $input.first().json;\nconst ai     = $input.first().json.aiOutput || {};\nconst side   = order.side.toUpperCase();\nconst emoji  = side === 'BUY' ? '🟢' : '🔴';\n\nreturn [{ json: {\n  // Order data from Alpaca\n  order_id:         order.id,\n  symbol:           order.symbol,\n  side:             side,\n  qty:              order.qty,\n  status:           order.status,\n  submitted_at:     order.submitted_at,\n  filled_at:        order.filled_at        ?? 'pending',\n  filled_price:     order.filled_avg_price ?? 'pending',\n  stop_loss:        order.legs?.[0]?.stop_price  ?? 'N/A',\n  take_profit:      order.legs?.[1]?.limit_price ?? 'N/A',\n\n  // AI decision data (pass these through from earlier nodes)\n  confidence:       ai.confidence  ?? 'N/A',\n  entry_price:      ai.entry_price ?? 'N/A',\n  reason:           ai.reason      ?? 'N/A',\n\n  // P&L placeholders\n  pnl:              '',\n  outcome:          'PENDING',\n\n  // Email\n  emoji:            emoji,\n  email_subject:    `${emoji} Trade Alert: ${side} ${order.qty} ${order.symbol}`,\n  email_body:       `Trade Executed\\n\\n${emoji} ${side} ORDER\\n\\nSymbol: ${order.symbol}\\nQty: ${order.qty}\\nFilled Price: $${order.filled_avg_price ?? 'pending'}\\nStop Loss: $${order.legs?.[0]?.stop_price ?? 'N/A'}\\nTake Profit: $${order.legs?.[1]?.limit_price ?? 'N/A'}\\nConfidence: ${ai.confidence ?? 'N/A'}\\nReason: ${ai.reason ?? 'N/A'}\\nOrder ID: ${order.id}`\n}}];"
      },
