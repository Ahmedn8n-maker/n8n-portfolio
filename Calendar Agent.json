      "typeVersion": 1.1
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Book a consultation for the following visitor:\n\nFull Name: {{ $json.FullName }}\nCompany: {{ $json.CompanyName }}\nEmail: {{ $json.email }}\nService: {{ $json.service }}\nPreferred Date & Time: {{ $json.preferredDateTime }}\n\nCheck availability for this slot first, then book it if available. If not available, suggest the 2 nearest available slots on the same day.",
        "options": {
          "systemMessage": "You are a calendar assistant for HQ Studios, a professional event management company in Riyadh, Saudi Arabia.\n\nYou have access to Google Calendar. Your job is to:\n1. First check if the requested time slot is available using the Check Availability tool.\n2. If available, book the meeting using the Book Meeting tool.\n3. If NOT available, find and suggest the 2 nearest available 60-minute slots on the same day.\n\nRules:\n- Always work in Asia/Riyadh timezone (GMT+3).\n- Meeting duration is always 60 minutes.\n- Never book without checking availability first.\n- Never double-book.\n\nWhen booking use:\n- Title: HQ Studios Consultation — {FullName} ({CompanyName})\n- Description: Service Interest: {service} | Client Email: {email}\n- Duration: 60 minutes\n- Send confirmation email to the visitor."
        }
      },
      "id": "150c29fb-3804-4ec4-854b-0a843ef988d2",
      "name": "Calendar AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        352,
        0
      ],
      "typeVersion": 1.7
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "7cf0efd0-dbfc-4413-b582-8bbc1ef447ae",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        256,
        208
      ],
      "typeVersion": 1,
      "credentials": {
        "googlePalmApi": {
          "id": "BI1jTrGltmTeZz6o",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Check if a time slot is available on the HQ Studios Google Calendar. Use this before booking any meeting.",
        "calendar": {
          "__rl": true,
          "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Calendar', ``, 'string') }}",
          "mode": "id",
          "__regex": "(^[a-zA-Z0-9.!#$%&’*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*)"
        },
        "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Start', ``, 'string') }}",
        "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('End', ``, 'string') }}",
        "additionalFields": {}
      },
      "id": "0f63d83e-592a-4826-80d7-51fa70d4c811",
      "name": "Check Availability",
      "type": "n8n-nodes-base.googleCalendarTool",
      "position": [
        464,
        224
      ],
      "typeVersion": 1.3,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "QFe00ZJpNhYFGNGn",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Book a 60-minute HQ Studios consultation meeting on Google Calendar. Only use this after confirming the slot is available.",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary"
        },
        "start": "={{ $json.preferredDateTime }}",
        "end": "={{ DateTime.fromISO($json.preferredDateTime).plus({hours: 1}).toISO() }}",
        "additionalFields": {
          "attendees": "={{ $json.email }}",
          "description": "=Service Interest: {{ $json.service }}\nClient Email: {{ $json.email }}",
          "sendUpdates": "all",
          "summary": "=HQ Studios Consultation — {{ $json.FullName }} ({{ $json.CompanyName }})"
        }
      },
      "id": "c4b2d0b8-df09-4fa7-a100-5c67ce36021d",
      "name": "Book Meeting",
      "type": "n8n-nodes-base.googleCalendarTool",
      "position": [
        656,
        224
      ],
      "typeVersion": 1.3,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "QFe00ZJpNhYFGNGn",
          "name": "Google Calendar account"
        }
      }
    },
    {
